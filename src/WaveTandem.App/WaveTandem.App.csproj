<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <AssemblyName>WaveTandem</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WaveTandem.Core\WaveTandem.Core.csproj" />
    <ProjectReference Include="..\WaveTandem.Audio.Interop\WaveTandem.Audio.Interop.csproj" />
    <EmbeddedResource Include="Localization/*.json" />
    <Content Include="$(NativeAudioPath)" Condition="'$(NativeAudioPath)' != ''" Link="WaveTandemAudio.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
