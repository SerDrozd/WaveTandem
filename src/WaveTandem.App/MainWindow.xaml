<Window x:Class="WaveTandem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveTandem" Width="820" Height="700" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="24,15">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"
                   FontSize="21" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock Text="WaveTandem" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Background="{DynamicResource Canvas}" BorderThickness="0" Padding="0"
                Margin="20,12,20,0">
      <TabItem Header="{Binding Text[SharingTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,12,10,16">
          <StackPanel IsEnabled="{Binding CanEdit}">
            <Border Background="{DynamicResource InfoSurface}" CornerRadius="6" Padding="15,12" Margin="0,0,0,12"
                    Visibility="{Binding ShowWelcome, Converter={StaticResource VisibleWhen}}">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{Binding Text[Dismiss]}" Click="DismissWelcome"
                        VerticalAlignment="Top" Margin="12,0,0,0" />
                <StackPanel>
                  <TextBlock Text="{Binding Text[WelcomeTitle]}" Style="{StaticResource Heading}" />
                  <TextBlock Text="{Binding Text[WelcomeBody]}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding Text[MainOutput]}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Text[SourceHelp]}" Style="{StaticResource Secondary}" Margin="0,3,0,9" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Source, Mode=TwoWay}"
                          ToolTip="{Binding Source.SourceLabel}" IsEnabled="{Binding CanSelectSource}"
                          AutomationProperties.Name="{Binding Text[MainOutput]}" MinHeight="34">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="{Binding Text[Listeners]}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Text[ListenersHelp]}" Style="{StaticResource Secondary}" Margin="0,3,0,10" />
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Label Target="{Binding ElementName=SearchBox}" Content="{Binding Text[Search]}" Padding="0,5,8,4" />
                  <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                           VerticalContentAlignment="Center" MinHeight="32" />
                  <Button Grid.Column="2" Content="{Binding Text[Refresh]}" Click="RefreshDevices" Margin="8,0,0,0" />
                </Grid>
                <CheckBox Content="{Binding Text[ShowTiming]}" IsChecked="{Binding Advanced}" Margin="0,3,0,8" />
                <TextBlock Text="{Binding Text[NoOutputs]}" Style="{StaticResource Secondary}"
                           Visibility="{Binding NoOutputs, Converter={StaticResource VisibleWhen}}" Margin="0,10,0,3" />
                <ItemsControl ItemsSource="{Binding Outputs}" IsEnabled="{Binding CanConfigure}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled}" ToolTip="{Binding Name}"
                                      AutomationProperties.Name="{Binding Name}" VerticalContentAlignment="Center">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            </CheckBox>
                            <TextBlock Grid.Column="1" Text="{Binding Connection}" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                          </Grid>
                          <Grid Margin="27,5,0,0" Visibility="{Binding Enabled, Converter={StaticResource VisibleWhen}}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="46" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text[Volume]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding Volume}" AutomationProperties.Name="{Binding Text[Volume]}" />
                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,4,0" />
                            <CheckBox Grid.Column="3" Content="{Binding Text[Mute]}" IsChecked="{Binding Muted}" Margin="12,0,0,0" />
                          </Grid>
                          <StackPanel Margin="27,8,0,0"
                                      Visibility="{Binding DataContext.Advanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                            <Grid Visibility="{Binding Enabled, Converter={StaticResource VisibleWhen}}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="66" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Text[ExtraDelay]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                              <Slider Grid.Column="1" Minimum="0" Maximum="500" SmallChange="5" LargeChange="25"
                                      TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                      Value="{Binding Delay}" AutomationProperties.Name="{Binding Text[ExtraDelay]}" />
                              <TextBlock Grid.Column="2" Text="{Binding Delay, StringFormat={}{0} ms}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding Diagnostics}" FontSize="12" Style="{StaticResource Secondary}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Text[DiagnosticsTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,12,10,16">
          <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding Text[MainOutput]}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding SourceDiagnostics}" Style="{StaticResource Secondary}" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding Text[Timing]}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Text[TimingNote]}" Style="{StaticResource Secondary}" Margin="0,5,0,6" />
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Secondary}" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="{Binding Text[RecentEvents]}" Style="{StaticResource Heading}" />
                <TextBox Text="{Binding RecentEvents, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding Text[RecentEvents]}"
                         VerticalScrollBarVisibility="Auto" MinHeight="92" MaxHeight="210" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Text[SettingsTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,10,16">
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="{Binding Text[Appearance]}" Style="{StaticResource Heading}" />
              <Label Content="{Binding Text[Language]}" Target="{Binding ElementName=LanguageBox}" Padding="0,8,0,4" />
              <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedValuePath="Code" DisplayMemberPath="Label"
                        SelectedValue="{Binding Language}" Width="240" HorizontalAlignment="Left" />
              <Label Content="{Binding Text[Theme]}" Target="{Binding ElementName=ThemeBox}" Padding="0,8,0,4" />
              <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedValuePath="Code" DisplayMemberPath="Label"
                        SelectedValue="{Binding Theme}" Width="240" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Text[Window]}" Style="{StaticResource Heading}" Margin="0,20,0,6" />
              <CheckBox Content="{Binding Text[CloseTray]}" IsChecked="{Binding CloseToTray}" />
              <TextBlock Text="{Binding Text[TrayHelp]}" Style="{StaticResource Secondary}" Margin="0,5,0,12" />
              <Button Content="{Binding Text[SoundSettings]}" HorizontalAlignment="Left" Click="OpenSoundSettings" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Text[AboutTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,10,16">
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="{Binding Text[AboutTitle]}" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding Text[AboutBody]}" Style="{StaticResource Secondary}" Margin="0,7,0,14" />
              <TextBlock Text="{Binding Text[License]}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Padding="24,13">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Notice}" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding ToggleLabel}" IsEnabled="{Binding CanToggle}"
                Click="ToggleSharing" FontWeight="SemiBold" MinWidth="186" Padding="18,8"
                Margin="14,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
