<Application x:Class="WaveTandem.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose" ThemeMode="System">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    <SolidColorBrush x:Key="Canvas" Color="#F5F7F6" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ink" Color="#17312B" />
    <SolidColorBrush x:Key="MutedInk" Color="#465C56" />
    <SolidColorBrush x:Key="Line" Color="#CFDAD6" />
    <SolidColorBrush x:Key="Accent" Color="#15674F" />
    <SolidColorBrush x:Key="InfoSurface" Color="#E7F3ED" />
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Application.Resources>
</Application>
