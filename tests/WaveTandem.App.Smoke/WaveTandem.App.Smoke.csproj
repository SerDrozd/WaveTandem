<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WaveTandem.App\WaveTandem.App.csproj" />
    <Content Include="$(NativeAudioPath)" Condition="'$(NativeAudioPath)' != ''" Link="WaveTandemAudio.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
